  "components": {
    "schemas": {
      "Presupuesto": {
        "type": "object",
        "properties": {
          "anio": {
            "type": "integer",
            "description": "Ejercicio"
          },
          "tipo": {
            "type": "string",
            "description": "ingreso | gasto"
          },
          "capitulo": {
            "type": "string",
            "description": "Capítulo de la clasificación económica"
          },
          "area_gasto": {
            "type": "string",
            "description": "Área de gasto (solo gastos)"
          },
          "inicial": {
            "type": "number",
            "description": "Crédito o previsión inicial (EUR)"
          },
          "definitivo": {
            "type": "number",
            "description": "Crédito o previsión definitiva (EUR)"
          },
          "ejecutado": {
            "type": "number",
            "description": "Obligaciones o derechos reconocidos netos (EUR)"
          },
          "estado": {
            "type": "string",
            "description": "liquidado | en_ejecucion"
          }
        }
      },
      "Contratos": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador de la entrada en PLACSP"
          },
          "expediente": {
            "type": "string",
            "description": "Número de expediente"
          },
          "objeto": {
            "type": "string",
            "description": "Objeto del contrato"
          },
          "tipo": {
            "type": "string",
            "description": "Tipo de contrato (CODICE ContractCode)"
          },
          "procedimiento": {
            "type": "string",
            "description": "Procedimiento (CODICE)"
          },
          "estado": {
            "type": "string",
            "description": "Estado de la licitación"
          },
          "cpv": {
            "type": "string",
            "description": "Código CPV principal"
          },
          "organo": {
            "type": "string",
            "description": "Órgano de contratación"
          },
          "fecha_adjudicacion": {
            "type": "string",
            "format": "date",
            "description": "Fecha de adjudicación"
          },
          "fecha_formalizacion": {
            "type": "string",
            "format": "date",
            "description": "Fecha de formalización"
          },
          "duracion_meses": {
            "type": "number",
            "description": "Duración en meses"
          },
          "presupuesto_base_sin_iva": {
            "type": "number",
            "description": "Presupuesto base de licitación sin IVA (EUR)"
          },
          "importe_adjudicacion_sin_iva": {
            "type": "number",
            "description": "Importe de adjudicación sin IVA (EUR)"
          },
          "importe_adjudicacion_con_iva": {
            "type": "number",
            "description": "Importe de adjudicación con IVA (EUR)"
          },
          "numero_ofertas": {
            "type": "integer",
            "description": "Número de ofertas recibidas"
          },
          "adjudicatario": {
            "type": "string",
            "description": "Adjudicatario"
          },
          "adjudicatario_nif": {
            "type": "string",
            "description": "NIF del adjudicatario"
          },
          "adjudicatario_pyme": {
            "type": "boolean",
            "description": "El adjudicatario es pyme"
          },
          "url": {
            "type": "string",
            "description": "Enlace a la licitación en PLACSP"
          },
          "fuente": {
            "type": "string",
            "description": "Origen del registro"
          }
        }
      },
      "Encargos": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador"
          },
          "objeto": {
            "type": "string",
            "description": "Objeto del encargo"
          },
          "medio_propio": {
            "type": "string",
            "description": "Medio propio"
          },
          "medio_propio_nif": {
            "type": "string",
            "description": "NIF del medio propio"
          },
          "fecha_encargo": {
            "type": "string",
            "format": "date",
            "description": "Fecha del encargo"
          },
          "importe_sin_iva": {
            "type": "number",
            "description": "Importe sin IVA (EUR)"
          },
          "duracion_meses": {
            "type": "number",
            "description": "Duración en meses"
          },
          "url": {
            "type": "string",
            "description": "Enlace al documento"
          },
          "fuente": {
            "type": "string",
            "description": "Origen del registro"
          }
        }
      },
      "Subvenciones": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Código de concesión"
