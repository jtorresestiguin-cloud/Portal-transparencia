  "components": {
    "schemas": {
      "Pressupost": {
        "type": "object",
        "description": "Pressupost i execució pressupostària",
        "properties": {
          "any": {
            "type": "integer",
            "description": "Exercici pressupostari"
          },
          "tipus": {
            "type": "string",
            "description": "ingres | despesa"
          },
          "capitol": {
            "type": "string",
            "description": "Capítol de la classificació econòmica",
            "enum": [
              "3",
              "4",
              "5",
              "7",
              "1",
              "2",
              "3",
              "4",
              "6"
            ]
          },
          "programa": {
            "type": "string",
            "description": "Programa de despesa (buit en ingressos)",
            "enum": [
              "P1",
              "P2",
              "P3",
              "P4",
              "P5",
              "P6"
            ]
          },
          "inicial": {
            "type": "number",
            "description": "Crèdit/previsió inicial (EUR)"
          },
          "definitiu": {
            "type": "number",
            "description": "Crèdit/previsió definitiva després de modificacions (EUR)"
          },
          "executat": {
            "type": "number",
            "description": "Obligacions reconegudes / drets reconeguts (EUR)"
