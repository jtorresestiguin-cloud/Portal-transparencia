          },
          "tipo_cargo": {
            "type": "string",
            "description": "Tipo de cargo"
          },
          "cargo": {
            "type": "string",
            "description": "Denominación del cargo"
          },
          "areas": {
            "type": "string",
            "description": "Áreas o delegaciones"
          },
          "grupo_municipal": {
            "type": "string",
