          "codigo_bdns": {
            "type": "string",
            "description": "Código BDNS de la convocatoria"
          },
          "convocatoria": {
            "type": "string",
            "description": "Título de la convocatoria"
          },
          "finalidad": {
            "type": "string",
            "description": "Finalidad"
          },
          "modalidad": {
            "type": "string",
            "description": "Modalidad de concesión"
          },
          "beneficiario": {
            "type": "string",
            "description": "Beneficiario"
          },
          "beneficiario_nif": {
            "type": "string",
            "description": "NIF del beneficiario (solo personas jurídicas)"
          },
          "fecha_concesion": {
            "type": "string",
            "format": "date",
            "description": "Fecha de concesión"
          },
          "importe": {
            "type": "number",
            "description": "Importe concedido (EUR)"
          },
          "fuente": {
            "type": "string",
            "description": "Origen del registro"
          }
        }
      },
      "Convenios": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador"
          },
          "objeto": {
            "type": "string",
            "description": "Objeto"
          },
          "partes": {
            "type": "string",
            "description": "Partes firmantes"
          },
          "tipo_parte": {
            "type": "string",
            "description": "Naturaleza de la otra parte"
          },
          "fecha_firma": {
            "type": "string",
            "format": "date",
            "description": "Fecha de firma"
          },
          "fecha_fin": {
            "type": "string",
            "format": "date",
            "description": "Fin de la vigencia"
          },
          "obligaciones_economicas": {
            "type": "number",
            "description": "Obligaciones económicas (EUR)"
          },
          "url": {
            "type": "string",
            "description": "Texto íntegro"
          }
        }
